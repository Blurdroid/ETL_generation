<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="09/23/2026" REPOSITORY_VERSION="189.98">
  <REPOSITORY CODEPAGE="UTF-8" DATABASETYPE="Oracle" NAME="REP_PROD" VERSION="189">
    <FOLDER DESCRIPTION="Enterprise Cortex pipelines" GROUP="" NAME="Cortex_DATA_VAULT" OWNER="Administrator" SHARED="NOTSHARED">
        <SOURCE DATABASETYPE="Oracle" DESCRIPTION="Staging source for Cortex" NAME="STG_Cortex_STAGING" OWNERNAME="dbo">
            <SOURCEFIELD NAME="ALERT_ID" DATATYPE="integer" PRECISION="15" KEYTYPE="PRIMARY KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PRECISION="15" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="ALERT_TYPE" DATATYPE="string" PRECISION="20" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="SEVERITY" DATATYPE="string" PRECISION="10" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="ALERT_STATUS" DATATYPE="string" PRECISION="15" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="CREATED_DATE" DATATYPE="timestamp" PRECISION="26" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        </SOURCE>

        <TARGET DATABASETYPE="Oracle" DESCRIPTION="Data Vault Hub for Cortex" NAME="HUB_Cortex">
            <TARGETFIELD NAME="HK_ALERT_ID" DATATYPE="string" PRECISION="32" KEYTYPE="PRIMARY KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="ALERT_ID" DATATYPE="integer" PRECISION="15" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="LOAD_DTS" DATATYPE="timestamp" PRECISION="26" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="REC_SRC" DATATYPE="string" PRECISION="50" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        </TARGET>

        <MAPPING DESCRIPTION="Loads STG_Cortex_STAGING into HUB_Cortex via hash-key generation" NAME="m_Cortex_LOAD_HUB">
            <TRANSFORMATION DESCRIPTION="Reads from STG_Cortex_STAGING" NAME="SQ_STG_Cortex_STAGING" TYPE="Source Qualifier">
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="ALERT_ID" NAME="ALERT_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="CUSTOMER_ID" NAME="CUSTOMER_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="ALERT_TYPE" NAME="ALERT_TYPE" PORTTYPE="INPUT/OUTPUT" PRECISION="20" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="SEVERITY" NAME="SEVERITY" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="ALERT_STATUS" NAME="ALERT_STATUS" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="date/time" EXPRESSION="CREATED_DATE" NAME="CREATED_DATE" PORTTYPE="INPUT/OUTPUT" PRECISION="26" SCALE="0"/>
            </TRANSFORMATION>
            <TRANSFORMATION DESCRIPTION="Generates hub hash key, load timestamp, record source" NAME="EXP_Cortex_GENERATE_KEYS" TYPE="Expression">
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="ALERT_ID" NAME="ALERT_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="MD5(TO_CHAR(ALERT_ID))" EXPRESSIONTYPE="GENERAL" NAME="HK_ALERT_ID" PORTTYPE="OUTPUT" PRECISION="32" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="date/time" EXPRESSION="SYSDATE" EXPRESSIONTYPE="GENERAL" NAME="LOAD_DTS" PORTTYPE="OUTPUT" PRECISION="29" SCALE="9"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="'Cortex_STAGING'" EXPRESSIONTYPE="GENERAL" NAME="REC_SRC" PORTTYPE="OUTPUT" PRECISION="50" SCALE="0"/>
            </TRANSFORMATION>
            <INSTANCE NAME="STG_Cortex_STAGING" TRANSFORMATION_NAME="STG_Cortex_STAGING" TRANSFORMATION_TYPE="Source Definition" TYPE="SOURCE"/>
            <INSTANCE NAME="SQ_STG_Cortex_STAGING" TRANSFORMATION_NAME="SQ_STG_Cortex_STAGING" TRANSFORMATION_TYPE="Source Qualifier" TYPE="TRANSFORMATION"/>
            <INSTANCE NAME="EXP_Cortex_GENERATE_KEYS" TRANSFORMATION_NAME="EXP_Cortex_GENERATE_KEYS" TRANSFORMATION_TYPE="Expression" TYPE="TRANSFORMATION"/>
            <INSTANCE NAME="HUB_Cortex" TRANSFORMATION_NAME="HUB_Cortex" TRANSFORMATION_TYPE="Target Definition" TYPE="TARGET"/>
        <CONNECTOR FROMFIELD="ALERT_ID" FROMINSTANCE="STG_Cortex_STAGING" TOFIELD="ALERT_ID" TOINSTANCE="SQ_STG_Cortex_STAGING"/>
        <CONNECTOR FROMFIELD="CUSTOMER_ID" FROMINSTANCE="STG_Cortex_STAGING" TOFIELD="CUSTOMER_ID" TOINSTANCE="SQ_STG_Cortex_STAGING"/>
        <CONNECTOR FROMFIELD="ALERT_TYPE" FROMINSTANCE="STG_Cortex_STAGING" TOFIELD="ALERT_TYPE" TOINSTANCE="SQ_STG_Cortex_STAGING"/>
        <CONNECTOR FROMFIELD="SEVERITY" FROMINSTANCE="STG_Cortex_STAGING" TOFIELD="SEVERITY" TOINSTANCE="SQ_STG_Cortex_STAGING"/>
        <CONNECTOR FROMFIELD="ALERT_STATUS" FROMINSTANCE="STG_Cortex_STAGING" TOFIELD="ALERT_STATUS" TOINSTANCE="SQ_STG_Cortex_STAGING"/>
        <CONNECTOR FROMFIELD="CREATED_DATE" FROMINSTANCE="STG_Cortex_STAGING" TOFIELD="CREATED_DATE" TOINSTANCE="SQ_STG_Cortex_STAGING"/>
        <CONNECTOR FROMFIELD="ALERT_ID" FROMINSTANCE="SQ_STG_Cortex_STAGING" TOFIELD="ALERT_ID" TOINSTANCE="EXP_Cortex_GENERATE_KEYS"/>
        <CONNECTOR FROMFIELD="HK_ALERT_ID" FROMINSTANCE="EXP_Cortex_GENERATE_KEYS" TOFIELD="HK_ALERT_ID" TOINSTANCE="HUB_Cortex"/>
        <CONNECTOR FROMFIELD="ALERT_ID" FROMINSTANCE="EXP_Cortex_GENERATE_KEYS" TOFIELD="ALERT_ID" TOINSTANCE="HUB_Cortex"/>
        <CONNECTOR FROMFIELD="LOAD_DTS" FROMINSTANCE="EXP_Cortex_GENERATE_KEYS" TOFIELD="LOAD_DTS" TOINSTANCE="HUB_Cortex"/>
        <CONNECTOR FROMFIELD="REC_SRC" FROMINSTANCE="EXP_Cortex_GENERATE_KEYS" TOFIELD="REC_SRC" TOINSTANCE="HUB_Cortex"/>
        </MAPPING>

        <WORKFLOW DESCRIPTION="Daily batch load for Cortex into Raw Data Vault" ISENABLED="YES" NAME="wf_Cortex_DAILY_BATCH" VERSIONNUMBER="1">
            <TASK DESCRIPTION="Initialize Variables" NAME="Start" REUSABLE="NO" TYPE="Start" VERSIONNUMBER="1"/>
            <SESSION DESCRIPTION="Extract from Source, generate hub key, load Hub" NAME="s_m_Cortex_LOAD_HUB" REUSABLE="NO" TYPE="Session" VERSIONNUMBER="1"/>
            <SESSION DESCRIPTION="Load Links and Sats" NAME="s_m_Cortex_LOAD_LINKS_SATS" REUSABLE="NO" TYPE="Session" VERSIONNUMBER="1"/>
            <WORKFLOWLINK CONDITION="" FROMTASK="Start" TOTASK="s_m_Cortex_LOAD_HUB"/>
            <WORKFLOWLINK CONDITION="$s_m_Cortex_LOAD_HUB.Status=SUCCEEDED" FROMTASK="s_m_Cortex_LOAD_HUB" TOTASK="s_m_Cortex_LOAD_LINKS_SATS"/>
        </WORKFLOW>
    </FOLDER>
  </REPOSITORY>
</POWERMART>