<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="09/23/2026" REPOSITORY_VERSION="189.98">
  <REPOSITORY CODEPAGE="UTF-8" DATABASETYPE="Oracle" NAME="REP_PROD" VERSION="189">
    <FOLDER DESCRIPTION="Enterprise CR2 pipelines" GROUP="" NAME="CR2_DATA_VAULT" OWNER="Administrator" SHARED="NOTSHARED">
        <SOURCE DATABASETYPE="Oracle" DESCRIPTION="Staging source for CR2" NAME="STG_CR2_STAGING" OWNERNAME="dbo">
            <SOURCEFIELD NAME="ATM_ID" DATATYPE="string" PRECISION="10" KEYTYPE="PRIMARY KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="CARD_NUMBER" DATATYPE="string" PRECISION="19" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="TXN_TYPE" DATATYPE="string" PRECISION="12" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="TXN_AMOUNT" DATATYPE="decimal" PRECISION="18" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="TXN_STATUS" DATATYPE="string" PRECISION="10" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="TXN_TIMESTAMP" DATATYPE="timestamp" PRECISION="26" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        </SOURCE>

        <TARGET DATABASETYPE="Oracle" DESCRIPTION="Data Vault Hub for CR2" NAME="HUB_CR2">
            <TARGETFIELD NAME="HK_ATM_ID" DATATYPE="string" PRECISION="32" KEYTYPE="PRIMARY KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="ATM_ID" DATATYPE="string" PRECISION="10" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="LOAD_DTS" DATATYPE="timestamp" PRECISION="26" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="REC_SRC" DATATYPE="string" PRECISION="50" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        </TARGET>

        <MAPPING DESCRIPTION="Loads STG_CR2_STAGING into HUB_CR2 via hash-key generation" NAME="m_CR2_LOAD_HUB">
            <TRANSFORMATION DESCRIPTION="Reads from STG_CR2_STAGING" NAME="SQ_STG_CR2_STAGING" TYPE="Source Qualifier">
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="ATM_ID" NAME="ATM_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="CARD_NUMBER" NAME="CARD_NUMBER" PORTTYPE="INPUT/OUTPUT" PRECISION="19" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="TXN_TYPE" NAME="TXN_TYPE" PORTTYPE="INPUT/OUTPUT" PRECISION="12" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="decimal" EXPRESSION="TXN_AMOUNT" NAME="TXN_AMOUNT" PORTTYPE="INPUT/OUTPUT" PRECISION="18" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="TXN_STATUS" NAME="TXN_STATUS" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="date/time" EXPRESSION="TXN_TIMESTAMP" NAME="TXN_TIMESTAMP" PORTTYPE="INPUT/OUTPUT" PRECISION="26" SCALE="0"/>
            </TRANSFORMATION>
            <TRANSFORMATION DESCRIPTION="Generates hub hash key, load timestamp, record source" NAME="EXP_CR2_GENERATE_KEYS" TYPE="Expression">
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="ATM_ID" NAME="ATM_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="MD5(TO_CHAR(ATM_ID))" EXPRESSIONTYPE="GENERAL" NAME="HK_ATM_ID" PORTTYPE="OUTPUT" PRECISION="32" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="date/time" EXPRESSION="SYSDATE" EXPRESSIONTYPE="GENERAL" NAME="LOAD_DTS" PORTTYPE="OUTPUT" PRECISION="29" SCALE="9"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="'CR2_STAGING'" EXPRESSIONTYPE="GENERAL" NAME="REC_SRC" PORTTYPE="OUTPUT" PRECISION="50" SCALE="0"/>
            </TRANSFORMATION>
            <INSTANCE NAME="STG_CR2_STAGING" TRANSFORMATION_NAME="STG_CR2_STAGING" TRANSFORMATION_TYPE="Source Definition" TYPE="SOURCE"/>
            <INSTANCE NAME="SQ_STG_CR2_STAGING" TRANSFORMATION_NAME="SQ_STG_CR2_STAGING" TRANSFORMATION_TYPE="Source Qualifier" TYPE="TRANSFORMATION"/>
            <INSTANCE NAME="EXP_CR2_GENERATE_KEYS" TRANSFORMATION_NAME="EXP_CR2_GENERATE_KEYS" TRANSFORMATION_TYPE="Expression" TYPE="TRANSFORMATION"/>
            <INSTANCE NAME="HUB_CR2" TRANSFORMATION_NAME="HUB_CR2" TRANSFORMATION_TYPE="Target Definition" TYPE="TARGET"/>
        <CONNECTOR FROMFIELD="ATM_ID" FROMINSTANCE="STG_CR2_STAGING" TOFIELD="ATM_ID" TOINSTANCE="SQ_STG_CR2_STAGING"/>
        <CONNECTOR FROMFIELD="CARD_NUMBER" FROMINSTANCE="STG_CR2_STAGING" TOFIELD="CARD_NUMBER" TOINSTANCE="SQ_STG_CR2_STAGING"/>
        <CONNECTOR FROMFIELD="TXN_TYPE" FROMINSTANCE="STG_CR2_STAGING" TOFIELD="TXN_TYPE" TOINSTANCE="SQ_STG_CR2_STAGING"/>
        <CONNECTOR FROMFIELD="TXN_AMOUNT" FROMINSTANCE="STG_CR2_STAGING" TOFIELD="TXN_AMOUNT" TOINSTANCE="SQ_STG_CR2_STAGING"/>
        <CONNECTOR FROMFIELD="TXN_STATUS" FROMINSTANCE="STG_CR2_STAGING" TOFIELD="TXN_STATUS" TOINSTANCE="SQ_STG_CR2_STAGING"/>
        <CONNECTOR FROMFIELD="TXN_TIMESTAMP" FROMINSTANCE="STG_CR2_STAGING" TOFIELD="TXN_TIMESTAMP" TOINSTANCE="SQ_STG_CR2_STAGING"/>
        <CONNECTOR FROMFIELD="ATM_ID" FROMINSTANCE="SQ_STG_CR2_STAGING" TOFIELD="ATM_ID" TOINSTANCE="EXP_CR2_GENERATE_KEYS"/>
        <CONNECTOR FROMFIELD="HK_ATM_ID" FROMINSTANCE="EXP_CR2_GENERATE_KEYS" TOFIELD="HK_ATM_ID" TOINSTANCE="HUB_CR2"/>
        <CONNECTOR FROMFIELD="ATM_ID" FROMINSTANCE="EXP_CR2_GENERATE_KEYS" TOFIELD="ATM_ID" TOINSTANCE="HUB_CR2"/>
        <CONNECTOR FROMFIELD="LOAD_DTS" FROMINSTANCE="EXP_CR2_GENERATE_KEYS" TOFIELD="LOAD_DTS" TOINSTANCE="HUB_CR2"/>
        <CONNECTOR FROMFIELD="REC_SRC" FROMINSTANCE="EXP_CR2_GENERATE_KEYS" TOFIELD="REC_SRC" TOINSTANCE="HUB_CR2"/>
        </MAPPING>

        <WORKFLOW DESCRIPTION="Daily batch load for CR2 into Raw Data Vault" ISENABLED="YES" NAME="wf_CR2_DAILY_BATCH" VERSIONNUMBER="1">
            <TASK DESCRIPTION="Initialize Variables" NAME="Start" REUSABLE="NO" TYPE="Start" VERSIONNUMBER="1"/>
            <SESSION DESCRIPTION="Extract from Source, generate hub key, load Hub" NAME="s_m_CR2_LOAD_HUB" REUSABLE="NO" TYPE="Session" VERSIONNUMBER="1"/>
            <SESSION DESCRIPTION="Load Links and Sats" NAME="s_m_CR2_LOAD_LINKS_SATS" REUSABLE="NO" TYPE="Session" VERSIONNUMBER="1"/>
            <WORKFLOWLINK CONDITION="" FROMTASK="Start" TOTASK="s_m_CR2_LOAD_HUB"/>
            <WORKFLOWLINK CONDITION="$s_m_CR2_LOAD_HUB.Status=SUCCEEDED" FROMTASK="s_m_CR2_LOAD_HUB" TOTASK="s_m_CR2_LOAD_LINKS_SATS"/>
        </WORKFLOW>
    </FOLDER>
  </REPOSITORY>
</POWERMART>