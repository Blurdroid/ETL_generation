<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="09/23/2026" REPOSITORY_VERSION="189.98">
  <REPOSITORY CODEPAGE="UTF-8" DATABASETYPE="Oracle" NAME="REP_PROD" VERSION="189">
    <FOLDER DESCRIPTION="Enterprise OFSAA pipelines" GROUP="" NAME="OFSAA_DATA_VAULT" OWNER="Administrator" SHARED="NOTSHARED">
        <SOURCE DATABASETYPE="Oracle" DESCRIPTION="Staging source for OFSAA" NAME="STG_OFSAA_STAGING" OWNERNAME="dbo">
            <SOURCEFIELD NAME="ENTITY_ID" DATATYPE="integer" PRECISION="15" KEYTYPE="PRIMARY KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="RISK_METRIC_CODE" DATATYPE="string" PRECISION="20" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="METRIC_VALUE" DATATYPE="decimal" PRECISION="18" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="REPORTING_DATE" DATATYPE="date" PRECISION="19" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="BASEL_CATEGORY" DATATYPE="string" PRECISION="15" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        </SOURCE>

        <TARGET DATABASETYPE="Oracle" DESCRIPTION="Data Vault Hub for OFSAA" NAME="HUB_OFSAA">
            <TARGETFIELD NAME="HK_ENTITY_ID" DATATYPE="string" PRECISION="32" KEYTYPE="PRIMARY KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="ENTITY_ID" DATATYPE="integer" PRECISION="15" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="LOAD_DTS" DATATYPE="timestamp" PRECISION="26" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="REC_SRC" DATATYPE="string" PRECISION="50" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        </TARGET>

        <MAPPING DESCRIPTION="Loads STG_OFSAA_STAGING into HUB_OFSAA via hash-key generation" NAME="m_OFSAA_LOAD_HUB">
            <TRANSFORMATION DESCRIPTION="Reads from STG_OFSAA_STAGING" NAME="SQ_STG_OFSAA_STAGING" TYPE="Source Qualifier">
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="ENTITY_ID" NAME="ENTITY_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="RISK_METRIC_CODE" NAME="RISK_METRIC_CODE" PORTTYPE="INPUT/OUTPUT" PRECISION="20" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="decimal" EXPRESSION="METRIC_VALUE" NAME="METRIC_VALUE" PORTTYPE="INPUT/OUTPUT" PRECISION="18" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="date/time" EXPRESSION="REPORTING_DATE" NAME="REPORTING_DATE" PORTTYPE="INPUT/OUTPUT" PRECISION="19" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="BASEL_CATEGORY" NAME="BASEL_CATEGORY" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            </TRANSFORMATION>
            <TRANSFORMATION DESCRIPTION="Generates hub hash key, load timestamp, record source" NAME="EXP_OFSAA_GENERATE_KEYS" TYPE="Expression">
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="ENTITY_ID" NAME="ENTITY_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="MD5(TO_CHAR(ENTITY_ID))" EXPRESSIONTYPE="GENERAL" NAME="HK_ENTITY_ID" PORTTYPE="OUTPUT" PRECISION="32" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="date/time" EXPRESSION="SYSDATE" EXPRESSIONTYPE="GENERAL" NAME="LOAD_DTS" PORTTYPE="OUTPUT" PRECISION="29" SCALE="9"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="'OFSAA_STAGING'" EXPRESSIONTYPE="GENERAL" NAME="REC_SRC" PORTTYPE="OUTPUT" PRECISION="50" SCALE="0"/>
            </TRANSFORMATION>
            <INSTANCE NAME="STG_OFSAA_STAGING" TRANSFORMATION_NAME="STG_OFSAA_STAGING" TRANSFORMATION_TYPE="Source Definition" TYPE="SOURCE"/>
            <INSTANCE NAME="SQ_STG_OFSAA_STAGING" TRANSFORMATION_NAME="SQ_STG_OFSAA_STAGING" TRANSFORMATION_TYPE="Source Qualifier" TYPE="TRANSFORMATION"/>
            <INSTANCE NAME="EXP_OFSAA_GENERATE_KEYS" TRANSFORMATION_NAME="EXP_OFSAA_GENERATE_KEYS" TRANSFORMATION_TYPE="Expression" TYPE="TRANSFORMATION"/>
            <INSTANCE NAME="HUB_OFSAA" TRANSFORMATION_NAME="HUB_OFSAA" TRANSFORMATION_TYPE="Target Definition" TYPE="TARGET"/>
        <CONNECTOR FROMFIELD="ENTITY_ID" FROMINSTANCE="STG_OFSAA_STAGING" TOFIELD="ENTITY_ID" TOINSTANCE="SQ_STG_OFSAA_STAGING"/>
        <CONNECTOR FROMFIELD="RISK_METRIC_CODE" FROMINSTANCE="STG_OFSAA_STAGING" TOFIELD="RISK_METRIC_CODE" TOINSTANCE="SQ_STG_OFSAA_STAGING"/>
        <CONNECTOR FROMFIELD="METRIC_VALUE" FROMINSTANCE="STG_OFSAA_STAGING" TOFIELD="METRIC_VALUE" TOINSTANCE="SQ_STG_OFSAA_STAGING"/>
        <CONNECTOR FROMFIELD="REPORTING_DATE" FROMINSTANCE="STG_OFSAA_STAGING" TOFIELD="REPORTING_DATE" TOINSTANCE="SQ_STG_OFSAA_STAGING"/>
        <CONNECTOR FROMFIELD="BASEL_CATEGORY" FROMINSTANCE="STG_OFSAA_STAGING" TOFIELD="BASEL_CATEGORY" TOINSTANCE="SQ_STG_OFSAA_STAGING"/>
        <CONNECTOR FROMFIELD="ENTITY_ID" FROMINSTANCE="SQ_STG_OFSAA_STAGING" TOFIELD="ENTITY_ID" TOINSTANCE="EXP_OFSAA_GENERATE_KEYS"/>
        <CONNECTOR FROMFIELD="HK_ENTITY_ID" FROMINSTANCE="EXP_OFSAA_GENERATE_KEYS" TOFIELD="HK_ENTITY_ID" TOINSTANCE="HUB_OFSAA"/>
        <CONNECTOR FROMFIELD="ENTITY_ID" FROMINSTANCE="EXP_OFSAA_GENERATE_KEYS" TOFIELD="ENTITY_ID" TOINSTANCE="HUB_OFSAA"/>
        <CONNECTOR FROMFIELD="LOAD_DTS" FROMINSTANCE="EXP_OFSAA_GENERATE_KEYS" TOFIELD="LOAD_DTS" TOINSTANCE="HUB_OFSAA"/>
        <CONNECTOR FROMFIELD="REC_SRC" FROMINSTANCE="EXP_OFSAA_GENERATE_KEYS" TOFIELD="REC_SRC" TOINSTANCE="HUB_OFSAA"/>
        </MAPPING>

        <WORKFLOW DESCRIPTION="Daily batch load for OFSAA into Raw Data Vault" ISENABLED="YES" NAME="wf_OFSAA_DAILY_BATCH" VERSIONNUMBER="1">
            <TASK DESCRIPTION="Initialize Variables" NAME="Start" REUSABLE="NO" TYPE="Start" VERSIONNUMBER="1"/>
            <SESSION DESCRIPTION="Extract from Source, generate hub key, load Hub" NAME="s_m_OFSAA_LOAD_HUB" REUSABLE="NO" TYPE="Session" VERSIONNUMBER="1"/>
            <SESSION DESCRIPTION="Load Links and Sats" NAME="s_m_OFSAA_LOAD_LINKS_SATS" REUSABLE="NO" TYPE="Session" VERSIONNUMBER="1"/>
            <WORKFLOWLINK CONDITION="" FROMTASK="Start" TOTASK="s_m_OFSAA_LOAD_HUB"/>
            <WORKFLOWLINK CONDITION="$s_m_OFSAA_LOAD_HUB.Status=SUCCEEDED" FROMTASK="s_m_OFSAA_LOAD_HUB" TOTASK="s_m_OFSAA_LOAD_LINKS_SATS"/>
        </WORKFLOW>
    </FOLDER>
  </REPOSITORY>
</POWERMART>