<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="09/23/2026" REPOSITORY_VERSION="189.98">
  <REPOSITORY CODEPAGE="UTF-8" DATABASETYPE="Oracle" NAME="REP_PROD" VERSION="189">
    <FOLDER DESCRIPTION="Enterprise T24 pipelines" GROUP="" NAME="T24_DATA_VAULT" OWNER="Administrator" SHARED="NOTSHARED">
        <SOURCE DATABASETYPE="Oracle" DESCRIPTION="Staging source for T24" NAME="STG_T24_STAGING" OWNERNAME="dbo">
            <SOURCEFIELD NAME="ACCOUNT_ID" DATATYPE="integer" PRECISION="15" KEYTYPE="PRIMARY KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PRECISION="15" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="BALANCE" DATATYPE="decimal" PRECISION="18" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="CURRENCY" DATATYPE="string" PRECISION="3" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="ACCOUNT_STATUS" DATATYPE="string" PRECISION="10" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="OPEN_DATE" DATATYPE="date" PRECISION="19" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        </SOURCE>

        <TARGET DATABASETYPE="Oracle" DESCRIPTION="Data Vault Hub for T24" NAME="HUB_T24">
            <TARGETFIELD NAME="HK_ACCOUNT_ID" DATATYPE="string" PRECISION="32" KEYTYPE="PRIMARY KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="ACCOUNT_ID" DATATYPE="integer" PRECISION="15" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="LOAD_DTS" DATATYPE="timestamp" PRECISION="26" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="REC_SRC" DATATYPE="string" PRECISION="50" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        </TARGET>

        <MAPPING DESCRIPTION="Loads STG_T24_STAGING into HUB_T24 via hash-key generation" NAME="m_T24_LOAD_HUB">
            <TRANSFORMATION DESCRIPTION="Reads from STG_T24_STAGING" NAME="SQ_STG_T24_STAGING" TYPE="Source Qualifier">
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="ACCOUNT_ID" NAME="ACCOUNT_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="CUSTOMER_ID" NAME="CUSTOMER_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="decimal" EXPRESSION="BALANCE" NAME="BALANCE" PORTTYPE="INPUT/OUTPUT" PRECISION="18" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="CURRENCY" NAME="CURRENCY" PORTTYPE="INPUT/OUTPUT" PRECISION="3" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="ACCOUNT_STATUS" NAME="ACCOUNT_STATUS" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="date/time" EXPRESSION="OPEN_DATE" NAME="OPEN_DATE" PORTTYPE="INPUT/OUTPUT" PRECISION="19" SCALE="0"/>
            </TRANSFORMATION>
            <TRANSFORMATION DESCRIPTION="Generates hub hash key, load timestamp, record source" NAME="EXP_T24_GENERATE_KEYS" TYPE="Expression">
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="ACCOUNT_ID" NAME="ACCOUNT_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="MD5(TO_CHAR(ACCOUNT_ID))" EXPRESSIONTYPE="GENERAL" NAME="HK_ACCOUNT_ID" PORTTYPE="OUTPUT" PRECISION="32" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="date/time" EXPRESSION="SYSDATE" EXPRESSIONTYPE="GENERAL" NAME="LOAD_DTS" PORTTYPE="OUTPUT" PRECISION="29" SCALE="9"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="'T24_STAGING'" EXPRESSIONTYPE="GENERAL" NAME="REC_SRC" PORTTYPE="OUTPUT" PRECISION="50" SCALE="0"/>
            </TRANSFORMATION>
            <INSTANCE NAME="STG_T24_STAGING" TRANSFORMATION_NAME="STG_T24_STAGING" TRANSFORMATION_TYPE="Source Definition" TYPE="SOURCE"/>
            <INSTANCE NAME="SQ_STG_T24_STAGING" TRANSFORMATION_NAME="SQ_STG_T24_STAGING" TRANSFORMATION_TYPE="Source Qualifier" TYPE="TRANSFORMATION"/>
            <INSTANCE NAME="EXP_T24_GENERATE_KEYS" TRANSFORMATION_NAME="EXP_T24_GENERATE_KEYS" TRANSFORMATION_TYPE="Expression" TYPE="TRANSFORMATION"/>
            <INSTANCE NAME="HUB_T24" TRANSFORMATION_NAME="HUB_T24" TRANSFORMATION_TYPE="Target Definition" TYPE="TARGET"/>
        <CONNECTOR FROMFIELD="ACCOUNT_ID" FROMINSTANCE="STG_T24_STAGING" TOFIELD="ACCOUNT_ID" TOINSTANCE="SQ_STG_T24_STAGING"/>
        <CONNECTOR FROMFIELD="CUSTOMER_ID" FROMINSTANCE="STG_T24_STAGING" TOFIELD="CUSTOMER_ID" TOINSTANCE="SQ_STG_T24_STAGING"/>
        <CONNECTOR FROMFIELD="BALANCE" FROMINSTANCE="STG_T24_STAGING" TOFIELD="BALANCE" TOINSTANCE="SQ_STG_T24_STAGING"/>
        <CONNECTOR FROMFIELD="CURRENCY" FROMINSTANCE="STG_T24_STAGING" TOFIELD="CURRENCY" TOINSTANCE="SQ_STG_T24_STAGING"/>
        <CONNECTOR FROMFIELD="ACCOUNT_STATUS" FROMINSTANCE="STG_T24_STAGING" TOFIELD="ACCOUNT_STATUS" TOINSTANCE="SQ_STG_T24_STAGING"/>
        <CONNECTOR FROMFIELD="OPEN_DATE" FROMINSTANCE="STG_T24_STAGING" TOFIELD="OPEN_DATE" TOINSTANCE="SQ_STG_T24_STAGING"/>
        <CONNECTOR FROMFIELD="ACCOUNT_ID" FROMINSTANCE="SQ_STG_T24_STAGING" TOFIELD="ACCOUNT_ID" TOINSTANCE="EXP_T24_GENERATE_KEYS"/>
        <CONNECTOR FROMFIELD="HK_ACCOUNT_ID" FROMINSTANCE="EXP_T24_GENERATE_KEYS" TOFIELD="HK_ACCOUNT_ID" TOINSTANCE="HUB_T24"/>
        <CONNECTOR FROMFIELD="ACCOUNT_ID" FROMINSTANCE="EXP_T24_GENERATE_KEYS" TOFIELD="ACCOUNT_ID" TOINSTANCE="HUB_T24"/>
        <CONNECTOR FROMFIELD="LOAD_DTS" FROMINSTANCE="EXP_T24_GENERATE_KEYS" TOFIELD="LOAD_DTS" TOINSTANCE="HUB_T24"/>
        <CONNECTOR FROMFIELD="REC_SRC" FROMINSTANCE="EXP_T24_GENERATE_KEYS" TOFIELD="REC_SRC" TOINSTANCE="HUB_T24"/>
        </MAPPING>

        <WORKFLOW DESCRIPTION="Daily batch load for T24 into Raw Data Vault" ISENABLED="YES" NAME="wf_T24_DAILY_BATCH" VERSIONNUMBER="1">
            <TASK DESCRIPTION="Initialize Variables" NAME="Start" REUSABLE="NO" TYPE="Start" VERSIONNUMBER="1"/>
            <SESSION DESCRIPTION="Extract from Source, generate hub key, load Hub" NAME="s_m_T24_LOAD_HUB" REUSABLE="NO" TYPE="Session" VERSIONNUMBER="1"/>
            <SESSION DESCRIPTION="Load Links and Sats" NAME="s_m_T24_LOAD_LINKS_SATS" REUSABLE="NO" TYPE="Session" VERSIONNUMBER="1"/>
            <WORKFLOWLINK CONDITION="" FROMTASK="Start" TOTASK="s_m_T24_LOAD_HUB"/>
            <WORKFLOWLINK CONDITION="$s_m_T24_LOAD_HUB.Status=SUCCEEDED" FROMTASK="s_m_T24_LOAD_HUB" TOTASK="s_m_T24_LOAD_LINKS_SATS"/>
        </WORKFLOW>
    </FOLDER>
  </REPOSITORY>
</POWERMART>