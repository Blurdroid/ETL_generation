<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="09/23/2026" REPOSITORY_VERSION="189.98">
  <REPOSITORY CODEPAGE="UTF-8" DATABASETYPE="Oracle" NAME="REP_PROD" VERSION="189">
    <FOLDER DESCRIPTION="Enterprise CARD400 pipelines" GROUP="" NAME="CARD400_DATA_VAULT" OWNER="Administrator" SHARED="NOTSHARED">
        <SOURCE DATABASETYPE="Oracle" DESCRIPTION="Staging source for CARD400" NAME="STG_CARD400_STAGING" OWNERNAME="dbo">
            <SOURCEFIELD NAME="CARD_NUMBER" DATATYPE="string" PRECISION="19" KEYTYPE="PRIMARY KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="TXN_ID" DATATYPE="integer" PRECISION="15" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="TXN_AMOUNT" DATATYPE="decimal" PRECISION="18" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="TXN_CURRENCY" DATATYPE="string" PRECISION="3" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="MERCHANT_CODE" DATATYPE="string" PRECISION="15" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="TXN_TIMESTAMP" DATATYPE="timestamp" PRECISION="26" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        </SOURCE>

        <TARGET DATABASETYPE="Oracle" DESCRIPTION="Data Vault Hub for CARD400" NAME="HUB_CARD400">
            <TARGETFIELD NAME="HK_CARD_NUMBER" DATATYPE="string" PRECISION="32" KEYTYPE="PRIMARY KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="CARD_NUMBER" DATATYPE="string" PRECISION="19" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="LOAD_DTS" DATATYPE="timestamp" PRECISION="26" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="REC_SRC" DATATYPE="string" PRECISION="50" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        </TARGET>

        <MAPPING DESCRIPTION="Loads STG_CARD400_STAGING into HUB_CARD400 via hash-key generation" NAME="m_CARD400_LOAD_HUB">
            <TRANSFORMATION DESCRIPTION="Reads from STG_CARD400_STAGING" NAME="SQ_STG_CARD400_STAGING" TYPE="Source Qualifier">
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="CARD_NUMBER" NAME="CARD_NUMBER" PORTTYPE="INPUT/OUTPUT" PRECISION="19" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="TXN_ID" NAME="TXN_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="decimal" EXPRESSION="TXN_AMOUNT" NAME="TXN_AMOUNT" PORTTYPE="INPUT/OUTPUT" PRECISION="18" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="TXN_CURRENCY" NAME="TXN_CURRENCY" PORTTYPE="INPUT/OUTPUT" PRECISION="3" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="MERCHANT_CODE" NAME="MERCHANT_CODE" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="date/time" EXPRESSION="TXN_TIMESTAMP" NAME="TXN_TIMESTAMP" PORTTYPE="INPUT/OUTPUT" PRECISION="26" SCALE="0"/>
            </TRANSFORMATION>
            <TRANSFORMATION DESCRIPTION="Generates hub hash key, load timestamp, record source" NAME="EXP_CARD400_GENERATE_KEYS" TYPE="Expression">
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="CARD_NUMBER" NAME="CARD_NUMBER" PORTTYPE="INPUT/OUTPUT" PRECISION="19" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="MD5(TO_CHAR(CARD_NUMBER))" EXPRESSIONTYPE="GENERAL" NAME="HK_CARD_NUMBER" PORTTYPE="OUTPUT" PRECISION="32" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="date/time" EXPRESSION="SYSDATE" EXPRESSIONTYPE="GENERAL" NAME="LOAD_DTS" PORTTYPE="OUTPUT" PRECISION="29" SCALE="9"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="'CARD400_STAGING'" EXPRESSIONTYPE="GENERAL" NAME="REC_SRC" PORTTYPE="OUTPUT" PRECISION="50" SCALE="0"/>
            </TRANSFORMATION>
            <INSTANCE NAME="STG_CARD400_STAGING" TRANSFORMATION_NAME="STG_CARD400_STAGING" TRANSFORMATION_TYPE="Source Definition" TYPE="SOURCE"/>
            <INSTANCE NAME="SQ_STG_CARD400_STAGING" TRANSFORMATION_NAME="SQ_STG_CARD400_STAGING" TRANSFORMATION_TYPE="Source Qualifier" TYPE="TRANSFORMATION"/>
            <INSTANCE NAME="EXP_CARD400_GENERATE_KEYS" TRANSFORMATION_NAME="EXP_CARD400_GENERATE_KEYS" TRANSFORMATION_TYPE="Expression" TYPE="TRANSFORMATION"/>
            <INSTANCE NAME="HUB_CARD400" TRANSFORMATION_NAME="HUB_CARD400" TRANSFORMATION_TYPE="Target Definition" TYPE="TARGET"/>
        <CONNECTOR FROMFIELD="CARD_NUMBER" FROMINSTANCE="STG_CARD400_STAGING" TOFIELD="CARD_NUMBER" TOINSTANCE="SQ_STG_CARD400_STAGING"/>
        <CONNECTOR FROMFIELD="TXN_ID" FROMINSTANCE="STG_CARD400_STAGING" TOFIELD="TXN_ID" TOINSTANCE="SQ_STG_CARD400_STAGING"/>
        <CONNECTOR FROMFIELD="TXN_AMOUNT" FROMINSTANCE="STG_CARD400_STAGING" TOFIELD="TXN_AMOUNT" TOINSTANCE="SQ_STG_CARD400_STAGING"/>
        <CONNECTOR FROMFIELD="TXN_CURRENCY" FROMINSTANCE="STG_CARD400_STAGING" TOFIELD="TXN_CURRENCY" TOINSTANCE="SQ_STG_CARD400_STAGING"/>
        <CONNECTOR FROMFIELD="MERCHANT_CODE" FROMINSTANCE="STG_CARD400_STAGING" TOFIELD="MERCHANT_CODE" TOINSTANCE="SQ_STG_CARD400_STAGING"/>
        <CONNECTOR FROMFIELD="TXN_TIMESTAMP" FROMINSTANCE="STG_CARD400_STAGING" TOFIELD="TXN_TIMESTAMP" TOINSTANCE="SQ_STG_CARD400_STAGING"/>
        <CONNECTOR FROMFIELD="CARD_NUMBER" FROMINSTANCE="SQ_STG_CARD400_STAGING" TOFIELD="CARD_NUMBER" TOINSTANCE="EXP_CARD400_GENERATE_KEYS"/>
        <CONNECTOR FROMFIELD="HK_CARD_NUMBER" FROMINSTANCE="EXP_CARD400_GENERATE_KEYS" TOFIELD="HK_CARD_NUMBER" TOINSTANCE="HUB_CARD400"/>
        <CONNECTOR FROMFIELD="CARD_NUMBER" FROMINSTANCE="EXP_CARD400_GENERATE_KEYS" TOFIELD="CARD_NUMBER" TOINSTANCE="HUB_CARD400"/>
        <CONNECTOR FROMFIELD="LOAD_DTS" FROMINSTANCE="EXP_CARD400_GENERATE_KEYS" TOFIELD="LOAD_DTS" TOINSTANCE="HUB_CARD400"/>
        <CONNECTOR FROMFIELD="REC_SRC" FROMINSTANCE="EXP_CARD400_GENERATE_KEYS" TOFIELD="REC_SRC" TOINSTANCE="HUB_CARD400"/>
        </MAPPING>

        <WORKFLOW DESCRIPTION="Daily batch load for CARD400 into Raw Data Vault" ISENABLED="YES" NAME="wf_CARD400_DAILY_BATCH" VERSIONNUMBER="1">
            <TASK DESCRIPTION="Initialize Variables" NAME="Start" REUSABLE="NO" TYPE="Start" VERSIONNUMBER="1"/>
            <SESSION DESCRIPTION="Extract from Source, generate hub key, load Hub" NAME="s_m_CARD400_LOAD_HUB" REUSABLE="NO" TYPE="Session" VERSIONNUMBER="1"/>
            <SESSION DESCRIPTION="Load Links and Sats" NAME="s_m_CARD400_LOAD_LINKS_SATS" REUSABLE="NO" TYPE="Session" VERSIONNUMBER="1"/>
            <WORKFLOWLINK CONDITION="" FROMTASK="Start" TOTASK="s_m_CARD400_LOAD_HUB"/>
            <WORKFLOWLINK CONDITION="$s_m_CARD400_LOAD_HUB.Status=SUCCEEDED" FROMTASK="s_m_CARD400_LOAD_HUB" TOTASK="s_m_CARD400_LOAD_LINKS_SATS"/>
        </WORKFLOW>
    </FOLDER>
  </REPOSITORY>
</POWERMART>