<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="09/23/2026" REPOSITORY_VERSION="189.98">
  <REPOSITORY CODEPAGE="UTF-8" DATABASETYPE="Oracle" NAME="REP_PROD" VERSION="189">
    <FOLDER DESCRIPTION="Enterprise IVR pipelines" GROUP="" NAME="IVR_DATA_VAULT" OWNER="Administrator" SHARED="NOTSHARED">
        <SOURCE DATABASETYPE="Oracle" DESCRIPTION="Staging source for IVR" NAME="STG_IVR_STAGING" OWNERNAME="dbo">
            <SOURCEFIELD NAME="CALL_ID" DATATYPE="integer" PRECISION="15" KEYTYPE="PRIMARY KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PRECISION="15" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="AGENT_ID" DATATYPE="integer" PRECISION="15" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="CALL_DURATION_SEC" DATATYPE="integer" PRECISION="10" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="DISPOSITION_CODE" DATATYPE="string" PRECISION="15" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <SOURCEFIELD NAME="CALL_TIMESTAMP" DATATYPE="timestamp" PRECISION="26" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        </SOURCE>

        <TARGET DATABASETYPE="Oracle" DESCRIPTION="Data Vault Hub for IVR" NAME="HUB_IVR">
            <TARGETFIELD NAME="HK_CALL_ID" DATATYPE="string" PRECISION="32" KEYTYPE="PRIMARY KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="CALL_ID" DATATYPE="integer" PRECISION="15" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="LOAD_DTS" DATATYPE="timestamp" PRECISION="26" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
            <TARGETFIELD NAME="REC_SRC" DATATYPE="string" PRECISION="50" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        </TARGET>

        <MAPPING DESCRIPTION="Loads STG_IVR_STAGING into HUB_IVR via hash-key generation" NAME="m_IVR_LOAD_HUB">
            <TRANSFORMATION DESCRIPTION="Reads from STG_IVR_STAGING" NAME="SQ_STG_IVR_STAGING" TYPE="Source Qualifier">
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="CALL_ID" NAME="CALL_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="CUSTOMER_ID" NAME="CUSTOMER_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="AGENT_ID" NAME="AGENT_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="CALL_DURATION_SEC" NAME="CALL_DURATION_SEC" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="DISPOSITION_CODE" NAME="DISPOSITION_CODE" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="date/time" EXPRESSION="CALL_TIMESTAMP" NAME="CALL_TIMESTAMP" PORTTYPE="INPUT/OUTPUT" PRECISION="26" SCALE="0"/>
            </TRANSFORMATION>
            <TRANSFORMATION DESCRIPTION="Generates hub hash key, load timestamp, record source" NAME="EXP_IVR_GENERATE_KEYS" TYPE="Expression">
            <TRANSFORMFIELD DATATYPE="integer" EXPRESSION="CALL_ID" NAME="CALL_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="MD5(TO_CHAR(CALL_ID))" EXPRESSIONTYPE="GENERAL" NAME="HK_CALL_ID" PORTTYPE="OUTPUT" PRECISION="32" SCALE="0"/>
            <TRANSFORMFIELD DATATYPE="date/time" EXPRESSION="SYSDATE" EXPRESSIONTYPE="GENERAL" NAME="LOAD_DTS" PORTTYPE="OUTPUT" PRECISION="29" SCALE="9"/>
            <TRANSFORMFIELD DATATYPE="string" EXPRESSION="'IVR_STAGING'" EXPRESSIONTYPE="GENERAL" NAME="REC_SRC" PORTTYPE="OUTPUT" PRECISION="50" SCALE="0"/>
            </TRANSFORMATION>
            <INSTANCE NAME="STG_IVR_STAGING" TRANSFORMATION_NAME="STG_IVR_STAGING" TRANSFORMATION_TYPE="Source Definition" TYPE="SOURCE"/>
            <INSTANCE NAME="SQ_STG_IVR_STAGING" TRANSFORMATION_NAME="SQ_STG_IVR_STAGING" TRANSFORMATION_TYPE="Source Qualifier" TYPE="TRANSFORMATION"/>
            <INSTANCE NAME="EXP_IVR_GENERATE_KEYS" TRANSFORMATION_NAME="EXP_IVR_GENERATE_KEYS" TRANSFORMATION_TYPE="Expression" TYPE="TRANSFORMATION"/>
            <INSTANCE NAME="HUB_IVR" TRANSFORMATION_NAME="HUB_IVR" TRANSFORMATION_TYPE="Target Definition" TYPE="TARGET"/>
        <CONNECTOR FROMFIELD="CALL_ID" FROMINSTANCE="STG_IVR_STAGING" TOFIELD="CALL_ID" TOINSTANCE="SQ_STG_IVR_STAGING"/>
        <CONNECTOR FROMFIELD="CUSTOMER_ID" FROMINSTANCE="STG_IVR_STAGING" TOFIELD="CUSTOMER_ID" TOINSTANCE="SQ_STG_IVR_STAGING"/>
        <CONNECTOR FROMFIELD="AGENT_ID" FROMINSTANCE="STG_IVR_STAGING" TOFIELD="AGENT_ID" TOINSTANCE="SQ_STG_IVR_STAGING"/>
        <CONNECTOR FROMFIELD="CALL_DURATION_SEC" FROMINSTANCE="STG_IVR_STAGING" TOFIELD="CALL_DURATION_SEC" TOINSTANCE="SQ_STG_IVR_STAGING"/>
        <CONNECTOR FROMFIELD="DISPOSITION_CODE" FROMINSTANCE="STG_IVR_STAGING" TOFIELD="DISPOSITION_CODE" TOINSTANCE="SQ_STG_IVR_STAGING"/>
        <CONNECTOR FROMFIELD="CALL_TIMESTAMP" FROMINSTANCE="STG_IVR_STAGING" TOFIELD="CALL_TIMESTAMP" TOINSTANCE="SQ_STG_IVR_STAGING"/>
        <CONNECTOR FROMFIELD="CALL_ID" FROMINSTANCE="SQ_STG_IVR_STAGING" TOFIELD="CALL_ID" TOINSTANCE="EXP_IVR_GENERATE_KEYS"/>
        <CONNECTOR FROMFIELD="HK_CALL_ID" FROMINSTANCE="EXP_IVR_GENERATE_KEYS" TOFIELD="HK_CALL_ID" TOINSTANCE="HUB_IVR"/>
        <CONNECTOR FROMFIELD="CALL_ID" FROMINSTANCE="EXP_IVR_GENERATE_KEYS" TOFIELD="CALL_ID" TOINSTANCE="HUB_IVR"/>
        <CONNECTOR FROMFIELD="LOAD_DTS" FROMINSTANCE="EXP_IVR_GENERATE_KEYS" TOFIELD="LOAD_DTS" TOINSTANCE="HUB_IVR"/>
        <CONNECTOR FROMFIELD="REC_SRC" FROMINSTANCE="EXP_IVR_GENERATE_KEYS" TOFIELD="REC_SRC" TOINSTANCE="HUB_IVR"/>
        </MAPPING>

        <WORKFLOW DESCRIPTION="Daily batch load for IVR into Raw Data Vault" ISENABLED="YES" NAME="wf_IVR_DAILY_BATCH" VERSIONNUMBER="1">
            <TASK DESCRIPTION="Initialize Variables" NAME="Start" REUSABLE="NO" TYPE="Start" VERSIONNUMBER="1"/>
            <SESSION DESCRIPTION="Extract from Source, generate hub key, load Hub" NAME="s_m_IVR_LOAD_HUB" REUSABLE="NO" TYPE="Session" VERSIONNUMBER="1"/>
            <SESSION DESCRIPTION="Load Links and Sats" NAME="s_m_IVR_LOAD_LINKS_SATS" REUSABLE="NO" TYPE="Session" VERSIONNUMBER="1"/>
            <WORKFLOWLINK CONDITION="" FROMTASK="Start" TOTASK="s_m_IVR_LOAD_HUB"/>
            <WORKFLOWLINK CONDITION="$s_m_IVR_LOAD_HUB.Status=SUCCEEDED" FROMTASK="s_m_IVR_LOAD_HUB" TOTASK="s_m_IVR_LOAD_LINKS_SATS"/>
        </WORKFLOW>
    </FOLDER>
  </REPOSITORY>
</POWERMART>